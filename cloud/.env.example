# Configurações de banco de dados
POSTGRES_DB='esus'
POSTGRES_USER='postgres'
POSTGRES_PASS='pass'
POSTGRES_HOST='db' # host.docker.internal
POSTGRES_PORT=5432
TRAINING=true

# Cria/atualiza automaticamente o papel PostgreSQL somente leitura na primeira
# inicialização e após cada restauração. Use um segredo forte somente no
# cloud/.env ou no secret manager; nunca versione o valor real.
ESUS_LEITURA_PASS='substitua-por-uma-senha-forte'

# Portas do host usadas pelo Nginx Proxy Manager.
# O PEC continua ouvindo internamente nas portas originais 80 e 443.
# HTTP_PORT=8082
# HTTPS_PORT=8443

# Em apps standalone sem certificados, apenas a porta 8080 é liberada
APP_PORT=8082

#  Timezone da aplicação que definirá o horário do sistema
TZ='America/Bahia'
